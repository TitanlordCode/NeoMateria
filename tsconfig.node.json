{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "vitest.snapshot-commands.*",
    "cypress.config.*",
    "nightwatch.conf.*",
    "eslint.config.*",
    ".storybook/vitest.setup.ts"
  ],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "@vitest/browser/providers/playwright"]
  }
}
