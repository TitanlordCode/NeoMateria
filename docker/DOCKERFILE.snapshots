# Pin the digest so local and CI always pull byte-identical bytes regardless
# of when they pulled — without this, Microsoft re-tagging `v1.59.1-jammy`
# (security patches, font updates) silently drifts snapshot rendering between
# environments and breaks pixel comparison.
FROM mcr.microsoft.com/playwright:v1.59.1-jammy@sha256:8a0360d39d1973be506dd59002904a774f6d697d4946c94063b3fd006461c8ff

WORKDIR /app

COPY package.json package-lock.json ./
RUN HUSKY=0 npm ci

# Source files are mounted via volume at runtime (.:/app).
# The node_modules layer above is preserved via an anonymous volume
# so the Linux binaries are not overwritten by the host's Windows modules.

CMD ["npm", "run", "test:storybook:snapshots:run"]
