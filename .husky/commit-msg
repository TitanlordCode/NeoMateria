#!/bin/sh
msg=$(cat "$1")
pattern="^(feat|fix|chore|ci|docs|refactor|test|style|perf|build|revert)(\(.+\))?!?: .{1,72}"

if ! echo "$msg" | grep -qE "$pattern"; then
    echo ""
    echo "❌ Invalid commit message format."
    echo "   Expected: type(scope): summary"
    echo "   Example:  feat(button): add pressed state"
    echo "   Types: feat|fix|chore|ci|docs|refactor|test|style|perf|build|revert"
    echo ""
    exit 1
fi
