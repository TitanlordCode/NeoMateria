{
	"name": "neo-materia",
	"version": "0.1.0-dev.7",
	"description": "A Vue 3 component library based on Atomic Design and Material Design colors.",
	"readme": "README-npm.md",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./*": {
			"import": "./dist/*.js",
			"types": "./dist/*.d.ts"
		},
		"./dist/neo-materia.css": "./dist/neo-materia.css"
	},
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist",
		"README-npm.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TitanlordCode/NeoMateria.git"
	},
	"author": "TitanlordCode",
	"license": "SEE LICENSE IN LICENSE",
	"scripts": {
		"dev": "npm run generate:files && docker-compose up --build storybook",
		"docker:build": "docker-compose build",
		"build": "npm run generate:files && vite build",
		"prepublishOnly": "npm run build",
		"preview": "vite preview",
		"test": "npm run type-check && npm run lint:check && npm run stylelint:css && npm run prettier:check && vitest run --project=unit --project=ssr --project=snapshot-utils --project=storybook && npm run test:storybook:snapshots",
		"test:unit": "vitest --project=unit",
		"test:storybook": "vitest run --project=storybook",
		"test:storybook:snapshots": "node docker/run-snapshots.mjs",
		"test:storybook:snapshots:run": "vitest run --project=storybook-snapshots",
		"test:storybook:update": "docker compose run --rm snapshots npx vitest run --project=storybook-snapshots --update",
		"test:storybook:snapshots:cleanup": "node scripts/cleanup-snapshots.mjs",
		"test:storybook:a11y": "vitest run --project=storybook",
		"size": "size-limit",
		"build-only": "npm run generate:files && vite build",
		"type-check": "vue-tsc --build",
		"lint:check": "eslint .",
		"lint:fix": "eslint . --fix",
		"stylelint:css": "stylelint \"src/**/*.{css,vue}\"",
		"stylelint:css:fix": "stylelint \"src/**/*.{css,vue}\" --fix",
		"prettier:check": "npx prettier --check src/",
		"prettier:fix": "npx prettier --write src/",
		"storybook": "storybook dev -p 3000 --no-open",
		"build-storybook": "storybook build --output-dir storybook-static",
		"generate:files": "npx ts-node scripts/pre-flight.ts",
		"prepare": "husky || true"
	},
	"dependencies": {
		"material-colors": "^1.2.6",
		"vue": "^3.5.13"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@size-limit/preset-small-lib": "^12.1.0",
		"@storybook/addon-a11y": "^10.3.3",
		"@storybook/addon-docs": "^10.3.3",
		"@storybook/addon-vitest": "^10.3.5",
		"@storybook/vue3": "^10.3.3",
		"@storybook/vue3-vite": "^10.3.3",
		"@tsconfig/node22": "^22.0.0",
		"@types/jsdom": "^21.1.7",
		"@types/node": "^22.13.1",
		"@vitejs/plugin-vue": "^5.2.1",
		"@vitejs/plugin-vue-jsx": "^4.2.0",
		"@vitest/browser": "^3.2.4",
		"@vitest/eslint-plugin": "1.1.25",
		"@vue/eslint-config-prettier": "^10.1.0",
		"@vue/eslint-config-typescript": "^14.3.0",
		"@vue/test-utils": "^2.4.6",
		"@vue/tsconfig": "^0.7.0",
		"eslint": "^9.18.0",
		"eslint-plugin-storybook": "^10.3.3",
		"eslint-plugin-vue": "^9.32.0",
		"husky": "^9.1.7",
		"jsdom": "^26.0.0",
		"lint-staged": "^16.4.0",
		"postcss-mixins": "^12.1.2",
		"postcss-pxtorem": "^6.1.0",
		"prettier": "^3.4.2",
		"semantic-release": "^24.2.9",
		"size-limit": "^12.1.0",
		"storybook": "^10.3.3",
		"stylelint": "^16.23.1",
		"stylelint-config-recommended-vue": "^1.6.1",
		"stylelint-config-standard": "^39.0.0",
		"stylelint-declaration-strict-value": "^1.10.11",
		"stylelint-order": "^7.0.0",
		"ts-node": "^10.9.2",
		"typescript": "~5.7.3",
		"vite": "^6.0.11",
		"vite-plugin-dts": "^4.5.4",
		"vite-plugin-vue-devtools": "^7.7.1",
		"vitest": "^3.0.5",
		"vue-tsc": "^2.2.0"
	},
	"eslintConfig": {
		"extends": [
			"plugin:storybook/recommended"
		]
	},
	"publishConfig": {
		"access": "public"
	},
	"overrides": {
		"@semantic-release/npm": "^13.1.5"
	},
	"lint-staged": {
		"*.{ts,tsx,vue}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{css,vue}": [
			"stylelint --fix"
		]
	}
}
